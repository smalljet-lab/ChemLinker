<?xml version="1.0" encoding="utf-8"?>
<!-- Compound Registry add-on for MestReNova. Installed by: python -m compound_registry.mnova install -->
<mestre_ui version="1.0" name="compoundRegistry" toolbarcontext="Compound Registry">
	<actions>
		<action name="compoundRegistryLink">
			<text>Link Spectrum to Compound ID...</text>
			<tooltip>Find the compound ID from the experiment number in the spectrum title and save the document under it</tooltip>
			<icon>compound_registry</icon>
		</action>
		<action name="compoundRegistrySave">
			<text>Save Report and PDF to Compound</text>
			<tooltip>Save the document, a PDF and the multiplet report with the compound ID (asks for the compound first when the document is not linked yet)</tooltip>
			<icon>compound_registry</icon>
		</action>
		<action name="compoundRegistryStructure">
			<text>Paste Structure on Spectrum</text>
			<tooltip>Put the structure of the linked compound on the current page (asks for the compound first when the document is not linked yet)</tooltip>
			<icon>compound_registry</icon>
		</action>
		<action name="compoundRegistryLibrary">
			<text>Compound Library...</text>
			<tooltip>Search the compounds of the registry and open the NMR document saved for one of them, to compare it with your spectrum</tooltip>
			<icon>compound_registry</icon>
		</action>
		<action name="compoundRegistryShow">
			<text>Show Linked Compound ID</text>
			<tooltip>Show the compound ID this document is linked to</tooltip>
		</action>
		<action name="compoundRegistryAuto">
			<text>Propose Compound ID when a Spectrum is Opened</text>
			<checkable>yes</checkable>
		</action>
	</actions>
	<menus>
		<menu name="Scripts">
			<submenu name="Compound Registry">
				<addaction name="compoundRegistrySave"/>
				<addaction name="compoundRegistryLink"/>
				<addaction name="compoundRegistryStructure"/>
				<addaction name="compoundRegistryLibrary"/>
				<addaction name="compoundRegistryShow"/>
				<addseparator/>
				<addaction name="compoundRegistryAuto"/>
			</submenu>
		</menu>
	</menus>
	<ribbon>
		<page id="pageTools">
			<group id="grpCompoundRegistry" name="Compound ID">
				<icon>compound_registry</icon>
				<addaction name="compoundRegistrySave"/>
				<addaction name="compoundRegistryLink"/>
				<addaction name="compoundRegistryStructure"/>
				<addaction name="compoundRegistryLibrary"/>
				<adddropdown name="compoundRegistryDropdown">
					<text>Options</text>
					<menu name="compoundRegistryDropdownMenu">
						<addaction name="compoundRegistryShow"/>
						<addaction name="compoundRegistryAuto"/>
					</menu>
				</adddropdown>
			</group>
		</page>
	</ribbon>
	<pixmaps>
		<pixmap name="compound_registry" format="base64">
