{
  "name": "compound-registry-extension",
  "version": "0.10.0",
  "private": true,
  "description": "Browser extension (Firefox and Chrome): local compound ID registry panel for the Sciformation ELN",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "build:chrome": "node build.mjs --chrome",
    "icons": "node scripts/make-icons.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "node scripts/run-vitest.mjs run",
    "package": "node scripts/package.mjs",
    "package:chrome": "node scripts/package.mjs --chrome"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "143.0.1",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "openchemlib": "9.25.2"
  }
}
