{
  "manifest_version": 3,
  "name": "ChemLinker",
  "version": "0.12.0",
  "description": "Looks up and issues permanent compound IDs from the local compound registry while you work in the Sciformation ELN.",
  "browser_specific_settings": {
    "gecko": {
      "id": "compound-registry@registry.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "nativeMessaging",
    "activeTab"
  ],
  "host_permissions": [
    "https://sciformation.chemie.unibas.ch/*"
  ],
  "action": {
    "default_title": "ChemLinker",
    "default_icon": "compounds-icon.svg",
    "default_area": "navbar",
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "commands": {
    "capture-reaction": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Capture reaction: read a drawn reaction from the current tab"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://sciformation.chemie.unibas.ch/*"
      ],
      "js": [
        "page-bridge.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://sciformation.chemie.unibas.ch/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
